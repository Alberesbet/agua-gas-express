rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Regras permissivas apenas para teste controlado entre os aparelhos.
    // Antes de usar com clientes reais, restringir os pedidos por proprietário e papel.
    match /orders/{orderId} {
      allow read, write: if request.auth != null;

      // As mensagens de voz ficam no próprio Firestore em Base64 nesta versão;
      // não dependem do Firebase Storage.
      match /messages/{messageId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
                      && request.resource.data.senderUid == request.auth.uid
                      && request.resource.data.type == 'audio'
                      && request.resource.data.audioBase64 is string
                      && request.resource.data.durationSeconds is int;
        allow update, delete: if request.auth != null;
      }
    }

    match /appConfig/{configId} {
      allow read, write: if request.auth != null;
    }
  }
}
